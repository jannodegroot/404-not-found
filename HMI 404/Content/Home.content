  {
    "event": "%s%ADS.PLC1.MAIN.fbInvoerBuffer1.fbKlep.o_eCurrentPosition%/s%",
    "actions": [
      {
        "objectType": "SwitchCase",
        "active": true,
        "compare": {
          "objectType": "Symbol",
          "valueType": "tchmi:server#/definitions/ADS-PLC1.eValvePosition",
          "symbolExpression": "%s%ADS.PLC1.MAIN.fbInvoerBuffer1.fbKlep.o_eCurrentPosition%/s%"
        },
        "cases": [
          {
            "caseValue": {
              "objectType": "StaticValue",
              "valueType": "tchmi:server#/definitions/ADS-PLC1.eValvePosition",
              "value": 1
            },
